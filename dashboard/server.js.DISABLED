const express = require('express');
const http = require('http');
const { Server } = require('socket.io');
const jwt = require('jsonwebtoken');
const cookieParser = require('cookie-parser');
const { execSync, exec } = require('child_process');
const path = require('path');
const crypto = require('crypto');

const app = express();
const server = http.createServer(app);
const io = new Server(server);

const PORT = process.env.DASHBOARD_PORT || 3333;
const JWT_SECRET = process.env.JWT_SECRET || crypto.randomBytes(32).toString('hex');
const ACCESS_TOKEN = process.env.ACCESS_TOKEN || crypto.randomBytes(16).toString('hex');

// Store the access token
console.log(`\n  Dashboard Access Token: ${ACCESS_TOKEN}`);
console.log(`  Use this token to sign in from your phone.\n`);

app.use(express.json());
app.use(cookieParser());
app.use(express.static(path.join(__dirname, 'public')));

// Auth middleware
function authMiddleware(req, res, next) {
  const token = req.cookies?.jwt || req.headers.authorization?.replace('Bearer ', '');
  if (!token) return res.status(401).json({ error: 'Not authenticated' });
  try {
    jwt.verify(token, JWT_SECRET);
    next();
  } catch {
    return res.status(401).json({ error: 'Invalid token' });
  }
}

// Login endpoint
app.post('/api/login', (req, res) => {
  const { token } = req.body;
  if (token === ACCESS_TOKEN) {
    const jwtToken = jwt.sign({ user: 'admin' }, JWT_SECRET, { expiresIn: '7d' });
    res.cookie('jwt', jwtToken, { httpOnly: true, maxAge: 7 * 24 * 60 * 60 * 1000 });
    return res.json({ success: true, jwt: jwtToken });
  }
  res.status(401).json({ error: 'Invalid access token' });
});

// Helper: run openclaw command
function ocRun(cmd, timeout = 15000) {
  try {
    const result = execSync(`openclaw ${cmd}`, {
      timeout,
      encoding: 'utf-8',
      windowsHide: true,
      env: { ...process.env, NO_COLOR: '1' }
    });
    return result;
  } catch (e) {
    return e.stdout || e.message;
  }
}

// Helper: parse sessions list from JSON
function parseSessionsJson() {
  try {
    const result = ocRun('sessions list --json --limit 100');
    return JSON.parse(result);
  } catch {
    return [];
  }
}

// API: Get agents
app.get('/api/agents', authMiddleware, (req, res) => {
  try {
    const result = ocRun('agents list --json');
    const agents = JSON.parse(result);
    res.json(agents);
  } catch {
    // Fallback: parse text output
    const text = ocRun('agents list');
    const agents = [];
    const lines = text.split('\n');
    let current = null;
    for (const line of lines) {
      const match = line.match(/^- (\S+)(?:\s+\(([^)]+)\))?/);
      if (match) {
        if (current) agents.push(current);
        current = { name: match[1], label: match[2] || match[1], model: '', routing: 0 };
      }
      if (current && line.includes('Model:')) {
        current.model = line.split('Model:')[1].trim();
      }
      if (current && line.includes('Identity:')) {
        current.identity = line.split('Identity:')[1].trim();
      }
    }
    if (current) agents.push(current);
    res.json(agents);
  }
});

// API: Get sessions
app.get('/api/sessions', authMiddleware, (req, res) => {
  try {
    const result = ocRun('sessions list --json --limit 50');
    res.json(JSON.parse(result));
  } catch {
    const text = ocRun('sessions list --limit 50');
    res.json({ raw: text });
  }
});

// API: Get status
app.get('/api/status', authMiddleware, (req, res) => {
  try {
    const text = ocRun('status');
    // Parse key fields
    const gateway = text.match(/Gateway\s*│\s*(.+?)│/)?.[1]?.trim() || 'unknown';
    const agents = text.match(/Agents\s*│\s*(.+?)│/)?.[1]?.trim() || 'unknown';
    const sessions = text.match(/Sessions\s*│\s*(.+?)│/)?.[1]?.trim() || 'unknown';

    // Parse channels
    const channels = [];
    const whatsapp = text.match(/WhatsApp\s*│\s*(\S+)\s*│\s*(\S+)\s*│\s*(.+?)│/);
    if (whatsapp) channels.push({ name: 'WhatsApp', enabled: whatsapp[1], state: whatsapp[2], detail: whatsapp[3].trim() });
    const slack = text.match(/Slack\s*│\s*(\S+)\s*│\s*(\S+)\s*│\s*(.+?)│/);
    if (slack) channels.push({ name: 'Slack', enabled: slack[1], state: slack[2], detail: slack[3].trim() });

    res.json({ gateway, agents, sessions, channels, raw: text });
  } catch (e) {
    res.json({ error: e.message });
  }
});

// API: Get models/auth status
app.get('/api/auth-status', authMiddleware, (req, res) => {
  try {
    const text = ocRun('models status');
    res.json({ raw: text });
  } catch (e) {
    res.json({ error: e.message });
  }
});

// API: Get cron jobs
app.get('/api/crons', authMiddleware, (req, res) => {
  try {
    const text = ocRun('cron list');
    res.json({ raw: text });
  } catch (e) {
    res.json({ error: e.message });
  }
});

// API: Send message to agent session
app.post('/api/message', authMiddleware, (req, res) => {
  const { channel, target, message } = req.body;
  try {
    const result = ocRun(`message send --channel ${channel} --target "${target}" --message "${message.replace(/"/g, '\\"')}"`, 30000);
    res.json({ success: true, result });
  } catch (e) {
    res.json({ error: e.message });
  }
});

// API: Send message via agent turn
app.post('/api/agent-message', authMiddleware, (req, res) => {
  const { agent, message } = req.body;
  exec(`openclaw agent --agent ${agent} --message "${message.replace(/"/g, '\\"')}" --local`, {
    timeout: 60000,
    encoding: 'utf-8',
    windowsHide: true,
    env: { ...process.env, NO_COLOR: '1' }
  }, (err, stdout, stderr) => {
    if (err) return res.json({ error: err.message, stdout, stderr });
    res.json({ success: true, result: stdout });
  });
});

// API: Gateway control
app.post('/api/gateway/:action', authMiddleware, (req, res) => {
  const { action } = req.params;
  if (!['restart', 'stop'].includes(action)) return res.status(400).json({ error: 'Invalid action' });
  try {
    const result = ocRun(`gateway ${action}`, 20000);
    res.json({ success: true, result });
  } catch (e) {
    res.json({ error: e.message });
  }
});

// API: Create agent
app.post('/api/agents/create', authMiddleware, (req, res) => {
  const { name, model, identity, type } = req.body;
  if (!name) return res.status(400).json({ error: 'Agent name is required' });
  try {
    let cmd = `agents create ${name}`;
    if (model) cmd += ` --model "${model}"`;
    if (identity) cmd += ` --identity "${identity}"`;
    if (type) cmd += ` --type ${type}`;
    const result = ocRun(cmd, 30000);
    res.json({ success: true, result });
  } catch (e) {
    res.json({ error: e.message });
  }
});

// API: Delete/terminate agent
app.post('/api/agents/delete', authMiddleware, (req, res) => {
  const { name } = req.body;
  if (!name) return res.status(400).json({ error: 'Agent name is required' });
  try {
    const result = ocRun(`agents delete ${name} --force`, 15000);
    res.json({ success: true, result });
  } catch (e) {
    res.json({ error: e.message });
  }
});

// API: Get agent detail
app.get('/api/agents/:name', authMiddleware, (req, res) => {
  try {
    const result = ocRun(`agents info ${req.params.name} --json`);
    res.json(JSON.parse(result));
  } catch {
    const text = ocRun(`agents info ${req.params.name}`);
    res.json({ raw: text });
  }
});

// API: Get logs
app.get('/api/logs', authMiddleware, (req, res) => {
  try {
    const result = ocRun('logs --limit 30');
    res.json({ raw: result });
  } catch (e) {
    res.json({ error: e.message });
  }
});

// Socket.io auth
io.use((socket, next) => {
  const token = socket.handshake.auth?.token;
  if (!token) return next(new Error('Authentication required'));
  try {
    jwt.verify(token, JWT_SECRET);
    next();
  } catch {
    next(new Error('Invalid token'));
  }
});

// Real-time polling
let lastStatus = null;
setInterval(() => {
  try {
    const text = ocRun('status', 10000);
    if (text !== lastStatus) {
      lastStatus = text;
      io.emit('status:update', { raw: text, timestamp: Date.now() });
    }
  } catch {}
}, 10000);

// Serve login page for unauthenticated requests
app.get('/', (req, res) => {
  res.sendFile(path.join(__dirname, 'public', 'index.html'));
});

server.listen(PORT, '0.0.0.0', () => {
  console.log(`  Dashboard running at http://0.0.0.0:${PORT}`);
  console.log(`  Access from phone: http://3.231.147.217:${PORT}\n`);
});
