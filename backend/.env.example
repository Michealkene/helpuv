# ============================================================
# HELPUVIO BACKEND ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/helpuvio

# Redis (optional - for caching)
REDIS_URL=redis://localhost:6379

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-this-in-production-make-it-long-and-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Paystack Payment
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# File Storage (Cloudflare R2 or AWS S3)
R2_ENDPOINT=https://xxxxxxxxxxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=helpuvio-datasets

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email (SendGrid)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@helpuvio.com

# Frontend URL (for redirects)
FRONTEND_URL=http://localhost:5173

# Environment
ENVIRONMENT=development

# Admin Settings
ADMIN_DEFAULT_EMAIL=admin@helpuvio.com
ADMIN_DEFAULT_PASSWORD=changeme123
