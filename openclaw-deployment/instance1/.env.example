# OpenClaw Instance 1 - Environment Variables
# Copy this file to .env and fill in your actual API keys

# OpenRouter API Key (Free or Paid)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Alternative: Use different OpenRouter API key for this instance
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxx

# Optional: Anthropic API Key (if you want to use Claude models directly)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: OpenAI API Key
# OPENAI_API_KEY=your_openai_api_key_here

# Instance Identifier
INSTANCE_NAME=instance1
INSTANCE_DESCRIPTION="Primary Free Agent"

# Gateway Settings
OPENCLAW_GATEWAY_TOKEN=instance1-token-change-me
OPENCLAW_PORT=18792

# Optional: Logging
LOG_LEVEL=info
# LOG_LEVEL=debug
