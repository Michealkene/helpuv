# OpenClaw Instance 2 - Environment Variables
# Copy this file to .env and fill in your actual API keys

# OpenRouter API Key (Free or Paid)
# Get your key from: https://openrouter.ai/keys
# Use a DIFFERENT key than instance1 for independent rate limits
OPENROUTER_API_KEY=your_second_openrouter_api_key_here

# Alternative: Use the same key as instance1 (shared rate limits)
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxx

# Optional: Anthropic API Key (if you want to use Claude models directly)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: OpenAI API Key
# OPENAI_API_KEY=your_openai_api_key_here

# Instance Identifier
INSTANCE_NAME=instance2
INSTANCE_DESCRIPTION="Secondary Free Agent"

# Gateway Settings
OPENCLAW_GATEWAY_TOKEN=instance2-token-change-me
OPENCLAW_PORT=18790

# Optional: Logging
LOG_LEVEL=info
# LOG_LEVEL=debug
