# OpenClaw Instance 3 - Environment Variables
# Copy this file to .env and fill in your actual API keys

# OpenRouter API Key (Free or Paid)
# Get your key from: https://openrouter.ai/keys
# Use a DIFFERENT key than instances 1 & 2 for independent rate limits
OPENROUTER_API_KEY=your_third_openrouter_api_key_here

# Alternative: Use the same key as other instances (shared rate limits)
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxx

# Optional: Anthropic API Key (if you want to use Claude models directly)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: OpenAI API Key
# OPENAI_API_KEY=your_openai_api_key_here

# Instance Identifier
INSTANCE_NAME=instance3
INSTANCE_DESCRIPTION="Tertiary Free Agent"

# Gateway Settings
OPENCLAW_GATEWAY_TOKEN=instance3-token-change-me
OPENCLAW_PORT=18791

# Optional: Logging
LOG_LEVEL=info
# LOG_LEVEL=debug
